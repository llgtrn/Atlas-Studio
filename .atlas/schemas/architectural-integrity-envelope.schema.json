{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.studio/schemas/architectural-integrity-envelope.schema.json",
  "title": "ArchitecturalIntegrityEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","envelope_id","subject_ref","genome_ref","status","elements","invariants","provenance_refs"],
  "properties": {
    "schema_version": {"type":"string","minLength":1},
    "envelope_id": {"type":"string","minLength":1},
    "subject_ref": {"type":"string","minLength":1},
    "genome_ref": {"type":"string","minLength":1},
    "selected_design_ref": {"type":["string","null"]},
    "blueprint_revision_ref": {"type":["string","null"]},
    "status": {"type":"string","enum":["ACTIVE","SUPERSEDED","DRAFT"]},
    "elements": {"type":"array","items":{"$ref":"#/$defs/element"}},
    "invariants": {"type":"array","items":{"$ref":"#/$defs/invariant"}},
    "provenance_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "notes": {"type":"array","items":{"type":"string"}}
  },
  "$defs": {
    "element": {
      "type":"object","additionalProperties":false,
      "required":["element_ref","classification"],
      "properties":{
        "element_ref":{"type":"string","minLength":1},
        "classification":{"type":"string","enum":["LOAD_BEARING","STRUCTURAL","REPLACEABLE","DECORATIVE"]},
        "owner_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "rationale":{"type":"string"},
        "evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "invariant": {
      "type":"object","additionalProperties":false,
      "required":["invariant_id","kind","strength","subject_refs","statement","falsification_conditions","violation_action","evidence_refs"],
      "properties":{
        "invariant_id":{"type":"string","minLength":1},
        "kind":{"type":"string","enum":["OWNERSHIP_BOUNDARY","DEPENDENCY_DIRECTION","AUTHORITY_BOUNDARY","STATE_SOURCE_OF_TRUTH","INTERFACE_PROTOCOL","LIFECYCLE_ORDERING","TEMPORAL_ORDERING","FAILURE_CONTAINMENT","RECOVERY_INVARIANT","PERSISTENCE_BOUNDARY","CONCURRENCY_BOUNDARY","SECURITY_TRUST_BOUNDARY","EXTERNAL_BOUNDARY","RESOURCE_SAFETY_BOUNDARY"]},
        "strength":{"type":"string","enum":["HARD","SOFT"]},
        "subject_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "statement":{"type":"string","minLength":1},
        "rule_ref":{"type":["string","null"]},
        "falsification_conditions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "expected_observation_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "violation_action":{"type":"string","enum":["REJECT","REQUIRE_REVIEW","DIAGNOSTIC_ONLY"]},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "supersedes_invariant_refs":{"type":"array","items":{"type":"string","minLength":1}}
      }
    }
  }
}