atlas 1

system AtlasStudio

entity Repository AtlasStudio {
    authority = canonical
}

entity Runtime Core {
    kind = backend
    language = rust
    responsibility = graph_semantics
}

entity Runtime Adapter {
    kind = backend
    language = rust
    responsibility = repository_observation
}

entity Runtime Runtime {
    kind = backend
    language = rust
    responsibility = orchestration
}

entity Runtime WebUI {
    kind = frontend
    language = typescript
    responsibility = graph_visualization
}

capability ParseAtlas {
    input = Source
    output = AST
}

capability CompileGraph {
    input = AST
    output = SystemGraph
}

capability ObserveRepository {
    input = Repository
    output = ObservedGraph
}

AtlasStudio ->contains-> Core
AtlasStudio ->contains-> Adapter
AtlasStudio ->contains-> Runtime
AtlasStudio ->contains-> WebUI

Core ->provides-> ParseAtlas
Core ->provides-> CompileGraph
Adapter ->provides-> ObserveRepository
Runtime ->depends_on-> Core
Runtime ->depends_on-> Adapter
WebUI ->depends_on-> Runtime

binding RuntimeCompiler {
    consumer = Runtime
    provider = Core
    capability = CompileGraph
}

binding RuntimeObservation {
    consumer = Runtime
    provider = Adapter
    capability = ObserveRepository
}

materialize Core {
    path = "core"
    language = rust
    glob = "src/**/*.rs"
}

materialize Adapter {
    path = "adapter"
    language = rust
    glob = "src/**/*.rs"
}

materialize Runtime {
    path = "runtime"
    language = rust
    glob = "src/**/*.rs"
}

materialize WebUI {
    path = "apps/studio"
}

constraint BackendIsRust {
    forall x: Runtime
        where x.kind == backend

    require x.language == rust
}

constraint CoreIsMaterialized {
    require materialized Core
}

constraint AdapterIsMaterialized {
    require materialized Adapter
}

constraint RuntimeIsMaterialized {
    require materialized Runtime
}

# G130 (ADR 0050): the load-bearing layering, quantified over census truth and decided by
# systemize over the composed census: no function of a lower layer calls a higher one.
invariant CoreCallsNoAdapter {
    forall f: function in Core forbid call to Adapter
}

invariant CoreCallsNoRuntime {
    forall f: function in Core forbid call to Runtime
}

invariant CoreCallsNoCli {
    forall f: function in Core forbid call to AtlasCli
}

invariant AdapterCallsNoRuntime {
    forall f: function in Adapter forbid call to Runtime
}

invariant AdapterCallsNoCli {
    forall f: function in Adapter forbid call to AtlasCli
}

invariant RuntimeCallsNoCli {
    forall f: function in Runtime forbid call to AtlasCli
}
