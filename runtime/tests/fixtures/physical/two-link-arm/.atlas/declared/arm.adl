atlas 1
system TwoLinkArm

entity Arm Arm1 {
    payload = 0.5 kg
    required_reach = 500 mm
    shoulder_torque_limit = 5 N*m
}

entity Link Upper {
    arm = Arm1
    index = 1
    length = 300 mm
    mass = 0.4 kg
}

entity Link Fore {
    arm = Arm1
    index = 2
    length = 0.25 m
    mass = 300 g
}

entity Joint Shoulder {
    arm = Arm1
    index = 1
    lower = -1.5 rad
    upper = 1.5 rad
}

entity Joint Elbow {
    arm = Arm1
    index = 2
    lower = -2 rad
    upper = 2 rad
}

entity Motor ShoulderMotor {
    joint = Shoulder
    gear_ratio = 50
    efficiency = 0.8
    torque_constant = 0.05 N*m/A
    rated_torque = 0.3 N*m
    max_current = 6 A
    winding_resistance = 2 ohm
    rail = Main
}

entity Motor ElbowMotor {
    joint = Elbow
    gear_ratio = 30
    efficiency = 0.8
    torque_constant = 50 mN*m/A
    rated_torque = 0.2 N*m
    max_current = 4 A
    rail = Main
}

entity Rail Main {
    voltage = 12 V
    max_current = 5 A
}

invariant LinksAreLight {
    forall l: Link
    require l.mass <= 0.5 kg
}
