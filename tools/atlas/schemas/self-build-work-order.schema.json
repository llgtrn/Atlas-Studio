{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:self-build-work-order:v1",
  "title": "Atlas SelfBuildWorkOrder v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_order_id",
    "parent_repository_revision",
    "target_capability",
    "capability_gap_ref",
    "rationale_evidence_refs",
    "allowed_scope",
    "constraint_envelope_ref",
    "authority_mode",
    "required_gates",
    "recensus_scope",
    "stop_conditions",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "atlas.self-build-work-order.v1"
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_repository_revision": {
      "type": "string",
      "minLength": 1
    },
    "parent_atlas_root_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_capability": {
      "type": "string",
      "minLength": 1
    },
    "capability_gap_ref": {
      "type": "string",
      "minLength": 1
    },
    "roadmap_coordinate": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraint_envelope_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_mode": {
      "enum": [
        "HUMAN_REQUIRED",
        "POLICY_AUTO",
        "HYBRID"
      ]
    },
    "provider_roles": {
      "type": "array",
      "items": {
        "enum": [
          "RESEARCH_PROVIDER",
          "DECISION_PROVIDER",
          "SYNTHESIS_PROVIDER",
          "VERIFICATION_PROVIDER"
        ]
      },
      "uniqueItems": true
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recensus_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback_or_escalation": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "ACTIVE",
        "BLOCKED",
        "COMPLETED",
        "SUPERSEDED",
        "REJECTED"
      ]
    }
  }
}
