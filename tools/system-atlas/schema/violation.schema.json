{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronica.system-atlas.violation.v2",
  "title": "System Atlas v2 architecture-compliance finding. A finding, never a canonical truth claim -- status distinguishes what static evidence can and cannot prove.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "severity", "status", "source", "evidence"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "CORE_TO_ADAPTER", "CORE_TO_APP", "CORE_TO_RUNTIME", "CORE_TO_ORGANISM",
        "RUNTIME_TO_APP", "RUNTIME_TO_ORGANISM",
        "ADAPTER_TO_ORGANISM", "ORGANISM_TO_ADAPTER",
        "ADAPTER_OWNS_CANONICAL_TRUTH", "APP_OWNS_CANONICAL_AUTHORITY",
        "LEGACY_CAP_DEPENDENCY", "TS_BACKEND_MIGRATION_REQUIRED",
        "DIRECT_WORLD_MUTATION", "DIRECT_ADAPTER_EXECUTION_FROM_APP",
        "AUTHORITY_BYPASS", "EXECUTION_ADMISSION_BYPASS",
        "DUPLICATE_EVENT_STORE", "DUPLICATE_AUTHORITY_ENGINE",
        "DUPLICATE_CAPABILITY_REGISTRY", "DUPLICATE_MEMORY_TRUTH_STORE"
      ]
    },
    "severity": { "type": "string", "enum": ["HARD", "REVIEW_REQUIRED"] },
    "status": {
      "type": "string",
      "enum": ["PROVEN", "STRUCTURAL_SIGNAL", "REVIEW_REQUIRED", "FALSE_POSITIVE_ALLOWED_BY_CONTRACT"]
    },
    "source": { "type": "string", "description": "Component id or file path the finding is anchored to." },
    "target": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
