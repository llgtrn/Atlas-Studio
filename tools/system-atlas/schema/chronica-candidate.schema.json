{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronica.system-atlas.chronica-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "chronica_reference_sha",
    "semantic_owner",
    "summary",
    "donor_ids",
    "evidence",
    "source_cell_id",
    "source_package_id",
    "source_repo",
    "source_repo_sha",
    "affected_packages"
  ],
  "properties": {
    "schema": {
      "const": "chronica.system-atlas.chronica-candidate.v1"
    },
    "candidate_id": {
      "type": "string"
    },
    "source_ops_repo": {
      "type": "string"
    },
    "source_ops_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "chronica_reference_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semantic_owner": {
      "type": "string",
      "pattern": "^(core|runtime|adapter|organism|apps|graph|bindings)/"
    },
    "summary": {
      "type": "string"
    },
    "donor_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "affected_ops": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_cell_id": {
      "type": "string",
      "minLength": 1
    },
    "source_package_id": {
      "type": "string",
      "minLength": 1
    },
    "source_repo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "source_repo_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "affected_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "cell_id",
          "package_id"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
